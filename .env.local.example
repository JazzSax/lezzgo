# Supabase — get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Base URL of this app (used for OAuth redirect). In dev this is http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Map style (MapLibre). OpenFreeMap needs no key. Swap for a MapTiler style URL if desired.
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Geocoding provider (Photon). Public instance needs no key; self-host later for scale.
PHOTON_BASE_URL=https://photon.komoot.io
